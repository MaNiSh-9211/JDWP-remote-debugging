# ============================================================================
# JDWP Live Debugger - .gitignore (public repo)
# ============================================================================

# --- Secrets & credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
*.truststore
kubeconfig
kubeconfig.yaml
*kubeconfig*
.secrets/
credentials.json
auth-token*.txt
captured-*.json
captured-*.txt

# --- Java / Maven ---
target/
classes/
*.class
*.jar
!**/maven-wrapper.jar
*.war
*.nar
*.ear
hs_err_pid*
replay_pid*
*.hprof
.mvn/timing.properties
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties

# --- Node / package managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- Frontend build outputs & caches ---
dist/
out/
.vite/
.turbo/
.parcel-cache/
*.tsbuildinfo
client/src/main/resources/static/

# --- Electron build artifacts ---
release/
**/release/
app-builder-lib/
builder-effective-config.yaml

# --- Tests & coverage ---
coverage/
.nyc_output/

# --- Runtime output / debug artifacts ---
logs/
*.log
*.log.*
debugging-report*
debug-report*
*-output.txt
client-output.txt
variable_output*.json
rebuild-test-summary.json
mcp-test-report.json

# --- Docker / Kubernetes local state ---
.docker/
kind-config-local.yaml

# --- IDEs ---
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
bin/
.metadata/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
.cursor/
.cursorrules

# --- OS ---
.DS_Store
._*
Thumbs.db
Desktop.ini

# --- Temp / backup files ---
*.swp
*.swo
*~
*.bak
*.tmp
*.temp
.cache/
compile_error*.txt
build_error.txt

# --- Archives ---
*.zip
*.tar.gz
*.rar

# --- Downloaded tools ---
tools/kind.exe
tools/kind
